{
  "name": "mcp-dolibarr",
  "version": "1.0.0",
  "description": "MCP Server for Dolibarr CRM/ERP",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./bundle": "./dist/bundle.js"
  },
  "scripts": {
    "build": "tsc",
    "build:bundle": "node scripts/build.mjs",
    "build:all": "npm run build && npm run build:bundle",
    "start": "node dist/index.js",
    "start:bundle": "node dist/bundle.js",
    "dev": "tsx watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "bundle:analyze": "node scripts/build.mjs --analyze",
    "postinstall": "pnpm approve-builds 2>/dev/null || true"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
